# ==============================================================================
# Local Voice Assistant - Environment Configuration Template
# Copy this file to .env and adjust variables as needed:
#   cp .env.example .env
# ==============================================================================

# Ollama LLM Settings
# Standard local setup: http://localhost:11434
# If running inside WSL2 and Ollama is on the Windows host, use your host IP (e.g., http://<WINDOWS_HOST_IP>:11434)
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=qwen3.5:4b
OLLAMA_TIMEOUT_SECONDS=120

# Whisper STT Settings
# Model size: tiny, base, small, medium, large-v3
WHISPER_MODEL=small
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
WHISPER_LANGUAGE=en

# Kokoro TTS Settings
KOKORO_MODEL_PATH=models/kokoro/kokoro-v1.0.onnx
KOKORO_VOICES_PATH=models/kokoro/voices-v1.0.bin
KOKORO_DEFAULT_VOICE=af_heart
KOKORO_DEFAULT_SPEED=1.0
KOKORO_DEFAULT_LANG=en-us

# Session Storage Settings
SESSION_MAX_HISTORY_TURNS=20
SESSION_DB_PATH=data/sessions.db
